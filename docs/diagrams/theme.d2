classes: {
  module: {
    style: {
      fill: "#ECECFF"
      stroke: "#9370DB"
      stroke-width: 2
      border-radius: 10
      font: mono
      font-color: "#333333"
      font-size: 22
      bold: false
    }
  }
  module_container: {
    style: {
      fill: "#ECECFF"
      stroke: "#9370DB"
      stroke-width: 2
      border-radius: 10
    }
  }
  module_title: {
    style: {
      fill: transparent
      stroke: transparent
      font: mono
      font-color: "#333333"
      font-size: 22
      bold: true
    }
  }
  module_detail: {
    style: {
      fill: transparent
      stroke: transparent
      font: mono
      font-color: "#333333"
      font-size: 18
      bold: false
      italic: true
    }
  }
  module_type: {
    width: 300
    height: 88
    style: {
      fill: "#ECECFF"
      stroke: "#9370DB"
      stroke-width: 2
      border-radius: 10
      font: mono
      font-color: "#333333"
      font-size: 30
      bold: false
    }
  }
  delivery: {
    style: {
      fill: "#D9EAD3"
      stroke: "#6AA84F"
      stroke-width: 2
      border-radius: 10
      font: mono
      font-color: "#333333"
      font-size: 22
      bold: false
    }
  }
  navigation: {
    style: {
      fill: "#FCE5CD"
      stroke: "#E69138"
      stroke-width: 2
      border-radius: 10
      font: mono
      font-color: "#333333"
      font-size: 22
      bold: false
    }
  }
  delivery_container: {
    style: {
      fill: "#D9EAD3"
      stroke: "#6AA84F"
      stroke-width: 2
      border-radius: 0
      font: mono
      font-color: "#222222"
      font-size: 24
      bold: true
    }
  }
  navigation_container: {
    style: {
      fill: "#FCE5CD"
      stroke: "#E69138"
      stroke-width: 2
      border-radius: 0
      font: mono
      font-color: "#222222"
      font-size: 24
      bold: true
    }
  }
  container: {
    label.near: top-left
    style: {
      fill: transparent
      stroke: "#222222"
      stroke-width: 2
      border-radius: 0
      font: mono
      font-color: "#222222"
      font-size: 22
      bold: true
    }
  }
  legend: {
    style: {
      fill: transparent
      stroke: transparent
      font: mono
      font-color: "#222222"
      font-size: 20
      bold: false
    }
  }
  layout: {
    style: {
      fill: transparent
      stroke: transparent
      border-radius: 0
    }
  }
  invisible: {
    label: ""
    style: {
      fill: transparent
      stroke: transparent
      opacity: 0
    }
  }
}

(*** -> ***)[*]: {
  style: {
    stroke: "#222222"
    stroke-width: 2
    font: mono
    font-color: "#222222"
    font-size: 18
  }
  target-arrowhead: {
    shape: triangle
    style: {
      fill: "#222222"
      stroke: "#222222"
    }
  }
}
